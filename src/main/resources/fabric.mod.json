{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Allows stairs and slabs to control the directions in which Redstone connects and powers",
  "authors": [
    {
      "name": "sophur",
      "contact": {
        "homepage": "https://github.com/sophuric"
      }
    }
  ],
  "contributors": [
    {
      "name": "axialeaa (Mod Icon)",
      "contact": {
        "homepage": "https://github.com/axialeaa"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/stairstone",
    "sources": "https://github.com/${repo_github}",
    "issues": "https://github.com/${repo_github}/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/stairstone/icon256.png",
  "environment": "*",
  "accessWidener": "stairstone.classtweaker",
  "entrypoints": {
    "main": [
      "me.sophur.stairstone.StairstoneMain"
    ]
  },
  "mixins": [
    "stairstone.mixins.json"
  ],
  "breaks": {
    "alternate-current": "*"
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "lithium:options": {
      "mixin.block.redstone_wire": false
    }
  }
}
